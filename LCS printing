 class Solution {
public:
    string lcs(string &s1, string &s2) {
        int n = s1.length();
        int m = s2.length();

        int t[n + 1][m + 1];

        // Initialization
        for(int i = 0; i < n + 1; i++) {
            for(int j = 0; j < m + 1; j++) {
                if(i == 0 || j == 0) {
                    t[i][j] = 0;
                }
            }
        }

        // LCS DP table
        for(int i = 1; i < n + 1; i++) {
            for(int j = 1; j < m + 1; j++) {

                if(s1[i - 1] == s2[j - 1]) {
                    t[i][j] = 1 + t[i - 1][j - 1];
                }
                else {
                    t[i][j] = max(t[i - 1][j], t[i][j - 1]);
                }
            }
        }

        // Printing LCS
        string ans = "";

        int i = n;
        int j = m;

        while(i > 0 && j > 0) {

            if(s1[i - 1] == s2[j - 1]) {
                ans += s1[i - 1];
                i--;
                j--;
            }
            else {
                if(t[i - 1][j] > t[i][j - 1]) {
                    i--;
                }
                else {
                    j--;
                }
            }
        }

        reverse(ans.begin(), ans.end());

        return ans;
    }
};
